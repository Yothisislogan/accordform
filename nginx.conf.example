# Reject writes before proxying or buffering a request body. Paths and query
# strings are never carried into redirects or access logs.
server {
    listen 80;
    server_name forms.weinsurethings.com;
    access_log off;
    error_log /dev/null crit;
    if ($request_method !~ ^(GET|HEAD)$) { return 410; }
    return 308 https://forms.weinsurethings.com/;
}
server {
    listen 443 ssl;
    server_name forms.weinsurethings.com;
    ssl_certificate /etc/letsencrypt/live/forms.weinsurethings.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forms.weinsurethings.com/privkey.pem;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 1k;
    if ($request_method !~ ^(GET|HEAD)$) { return 410; }
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    location / {
        proxy_pass http://127.0.0.1:8097;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
    }
}
