[Unit]
Description=WiT Forms handoff to WiTNext (no customer storage)
After=network.target

[Service]
Type=simple
User=witforms
Group=witforms
WorkingDirectory=/opt/wit-forms-new
EnvironmentFile=/etc/wit-forms/witforms.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/wit-forms-new/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8097 --worker-tmp-dir /dev/shm --access-logfile /dev/null --error-logfile /dev/null "app:create_app()"
StandardOutput=null
StandardError=null
LimitCORE=0
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/wit-forms-new

[Install]
WantedBy=multi-user.target
