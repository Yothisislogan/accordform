# WiT Forms portal — the only application setting.
# Set the actual paired WiTNext HTTPS origin, without a path or trailing slash.
# Example syntax only: WITNEXT_ORIGIN=https://your-witnext.example.com
# No default is assumed: choosing a staging/production environment is explicit.
WITNEXT_ORIGIN=

# Production: /etc/wit-forms/witforms.env, loaded by witforms.service.
# Local development: export WITNEXT_ORIGIN before starting app.py.
# The portal does not load .env itself. Do not add database, OAuth, Hedge,
# SMTP, storage or customer credentials here; those belong only in WiTNext.
