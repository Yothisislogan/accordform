# WIT Forms — environment template.
# Copy to /etc/wit-forms/witforms.env (chmod 600) in production, or `.env` in dev.
# NOTHING in here that is real/secret belongs in git.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
PORT=8097
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true

# --- Paths (defaults are fine for /opt/wit-forms) ---
# DATA_DIR=/opt/wit-forms/data
# TEMPLATES_DIR=/opt/wit-forms/templates/acord
PDF_RETENTION_DAYS=30            # TODO(logan): confirm retention window

# --- Google OAuth (domain-restricted) --- TODO(logan): supply
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://forms.weinsurethings.com/auth/callback
ALLOWED_DOMAINS=weinsurethings.com
# ALLOWED_EMAILS=contractor@example.com      # optional edge-case allowlist
ADMIN_EMAILS=logan@weinsurethings.com

# --- Email --- TODO(logan): pick transport + supply creds
OWNER_CC_EMAIL=owner@weinsurethings.com      # ALWAYS CC'd, enforced server-side
EMAIL_TRANSPORT=smtp                         # smtp | sendgrid
EMAIL_FROM=forms@weinsurethings.com
EMAIL_FROM_NAME=We Insure Things

# SMTP (if EMAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# SendGrid (if EMAIL_TRANSPORT=sendgrid)
SENDGRID_API_KEY=

# --- Gemini (insurance proposal generator at /proposal) --- TODO(logan): supply
# Server-side only — never exposed to the browser. Get a key from Google AI Studio.
GEMINI_API_KEY=
# Model IDs change over time; override here without touching code.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# --- Hedge (Taven Tech broker platform) --- submit -> market -> quote
# Machine credentials from Hedge Settings -> API keys; exchanged for OAuth.
# Never put these in browser JS or the WordPress theme. An admin-created key
# and Hedge-enabled brokerage submission access are needed for broker_submit.
HEDGE_ENV=staging                        # staging | prod — start on staging
HEDGE_SCOPES=broker_mcp broker_submit
HEDGE_TIMEOUT=60
HEDGE_CLIENT_ID=
HEDGE_CLIENT_SECRET=
# If machine credentials are empty, staff can use the existing device login.
# Replace obsolete HEDGE_API_KEY/HEDGE_API_KEY_HEADER settings; they are unsupported.
# Endpoint-specific whsec_ secret from Hedge Settings -> Webhooks.
HEDGE_WEBHOOK_SECRET=
# A DIFFERENT random >=32-character secret shared only with WordPress.
WIT_INTAKE_SECRET=

# Phase gate: live writes (create/upload/finalize) are OFF until this is 1.
# Phase 1 (appetite + checklist at /appetite) needs no credentials at all.
HEDGE_LIVE=0
# Credentials at rest: with this set, Hedge tokens are Fernet-encrypted in the
# DB (hedge_credentials table). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in dev to fall back to the 0600 JSON file in DATA_DIR.
HEDGE_CRED_KEY=
# Public feed cache TTL in seconds (changes.json is probed before refetching).
HEDGE_FEED_TTL=86400
# Remote-status poll interval in seconds (min 60; only runs when HEDGE_LIVE=1).
HEDGE_POLL_INTERVAL=300

# --- Tooling ---
PDFTK_BIN=pdftk
